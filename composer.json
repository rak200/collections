{
    "name": "rak200/collections",
    "description": "Typed generic collections for PHP 8.4+ (Vector, LinkedList, Queue, Stack, Set, Map).",
    "version": "0.0.5",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "rak200",
            "email": "rak.ricardo@windowslive.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "rak200/caster": "^1.0.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/rak200/caster"
        }
    ],
    "autoload": {
        "psr-4": {
            "Rak200\\Collections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rak200\\Collections\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "scripts": {
        "test": "phpunit"
    }
}
